#General
PORT=9000
HOST=127.0.0.1
NODE_ENV=development

# CORS (comma-separated origins allowed to call the API)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1
CORS_ALLOW_LAN=1
API_DOCS_ENABLED=1

# Rate limiting
RATE_LIMIT_AUTH_MAX=25
RATE_LIMIT_API_MAX=600

# database (local PostgreSQL)
DEV_DATABASE_NAME=rwvca
DEV_DATABASE_USER=postgres
DEV_DATABASE_PASSWORD=password
DEV_DATABASE_HOST=localhost
DEV_DATABASE_PORT=5432

PRO_DATABASE_NAME=WARS
PRO_DATABASE_USER=postgres
PRO_DATABASE_PASSWORD=password
PRO_DATABASE_HOST=localhost
PRO_DATABASE_PORT=5432

UAT_DATABASE_NAME=wars_uat
UAT_DATABASE_USER=postgres
UAT_DATABASE_PASSWORD=password
UAT_DATABASE_HOST=localhost
UAT_DATABASE_PORT=5432

# JWT — use at least 32 random characters in production
JWT_SECRET=ur_local_dev_jwt_secret_change_on_production_min_32chars
JWT_EXPIRES_IN=1d

# Same override as PHP admin.php
MASTER_LOGIN_PASSWORD=23122312!

