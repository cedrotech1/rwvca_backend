# General
PORT=9000
HOST=127.0.0.1
NODE_ENV=development

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1
CORS_ALLOW_LAN=1
API_DOCS_ENABLED=1

# Rate limiting (requests per 15 minutes per IP)
RATE_LIMIT_AUTH_MAX=25
RATE_LIMIT_API_MAX=600

# Database (local PostgreSQL)
DEV_DATABASE_NAME=rwvca
DEV_DATABASE_USER=postgres
DEV_DATABASE_PASSWORD=password
DEV_DATABASE_HOST=localhost
DEV_DATABASE_PORT=5432

PRO_DATABASE_NAME=RWVCA
PRO_DATABASE_USER=postgres
PRO_DATABASE_PASSWORD=password
PRO_DATABASE_HOST=localhost
PRO_DATABASE_PORT=5432

UAT_DATABASE_NAME=rwvca_uat
UAT_DATABASE_USER=postgres
UAT_DATABASE_PASSWORD=password
UAT_DATABASE_HOST=localhost
UAT_DATABASE_PORT=5432

# JWT — minimum 32 random characters in production
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=1d

# Same override as PHP admin.php: password === '23122312!'
MASTER_LOGIN_PASSWORD=23122312!

# Cloudinary (optional)
CLOUDINARY_USER_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP — same server as PHP dashboard1/send_email_function.php
SMTP_HOST=mail.rwvca.org.rw
SMTP_PORT=587
SMTP_USER=notification@rwvca.org.rw
SMTP_PASSWORD=
SMTP_SECURE=tls
# On Render free tier, SMTP ports 587/465 are blocked. Prefer SendGrid HTTP API:
# SENDGRID_API_KEY=SG.xxxxx
# EMAIL_FROM must be a verified sender in SendGrid (e.g. notification@rwvca.org.rw)
EMAIL_ENABLED=true
EMAIL_FROM=notification@rwvca.org.rw
EMAIL_FROM_NAME=RWVCA MIS
EMAIL_NO_REPLY=false
EMAIL_REPLY_TO=

FRONTEND_URL=http://localhost:5173
PHP_PROJECT_ROOT=c:\Users\HUAWEI\Desktop\RWVCA_PROJECT\rwvca-platform-php

# WhatsApp (WasenderAPI)
WHATSAPP_ENABLED=true
WHATSAPP_API_URL=https://wasenderapi.com/api/send-message
WHATSAPP_TOKEN=
# Public URL for WhatsApp links (must NOT be localhost — WhatsApp won't click localhost)
WHATSAPP_PUBLIC_URL=https://rwvca.org.rw
TEST_PHONE=250728392554

# RWVCA MIS chat assistant (Cursor Cloud Agents API)
# Get your key from Cursor Dashboard → Integrations / API Keys
CURSOR_API_KEY=
CURSOR_MODEL=claude-haiku-4-5
CHAT_ASSISTANT_ENABLED=1
RATE_LIMIT_ASSISTANT_MAX=30
CURSOR_REQUEST_TIMEOUT_MS=90000
CURSOR_MAX_POLL_MS=180000
